              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="7">
                    <item name="Description" type_name="gh_string" type_code="10">Lets you inspect the current state of the shells in a model. Plug it into the definition after a ModelView-component so that you can fine-tune the model display with it.</item>
