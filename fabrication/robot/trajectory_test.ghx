                    <item name="TransformFeedbackVertexShader" type_name="gh_string" type_code="10"></item>
                    <item name="VertexShader" type_name="gh_string" type_code="10">#version 330

layout(location = 0) in vec3 vertex;
layout(location = 1) in vec4 vcolor;
uniform mat4 _worldToClip;
out vec4 vertex_color;

void main() 
{
  vertex_color = vcolor;
  gl_Position = _worldToClip * vec4(vertex,1);
}
</item>
