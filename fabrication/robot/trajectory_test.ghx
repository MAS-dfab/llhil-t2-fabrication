                    <item name="FragmentShader" type_name="gh_string" type_code="10">#version 330

in vec4 vertex_color;
out vec4 final_color;

void main()
{
  final_color = vertex_color;
}
</item>
                    <item name="GLShader" type_name="gh_version" type_code="80">
                      <Major>0</Major>
